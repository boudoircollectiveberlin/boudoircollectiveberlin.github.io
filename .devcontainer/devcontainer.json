{
  "name": "BCB Redaktion · GitHub-Beitragende",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "BCB Redaktion öffnen · privat", "onAutoForward": "openBrowser", "protocol": "http" }
  },
  "containerEnv": { "BCB_EDITOR_PROFILE": "contributor", "ASTRO_TELEMETRY_DISABLED": "1" },
  "postCreateCommand": "npm ci",
  "postStartCommand": "bash .devcontainer/start-editor.sh",
  "postAttachCommand": "bash .devcontainer/start-editor.sh",
  "customizations": { "vscode": { "extensions": ["astro-build.astro-vscode"] } }
}
