# Google service account JSON, pasted as a single line or Vercel multiline env var.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Firebase Web App config. These values are public client config, but keep them centralized in Vercel.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=1:123456789:web:abcdef123456
AUTH_PROVIDERS=google,microsoft,github

# Google Sheet that receives registration rows.
REGISTRATION_SHEET_ID=your-google-sheet-id
REGISTRATION_SHEET_RANGE=Registrations!A:Z
MEMBER_SHEET_RANGE=Members!A:Z

# Admins and transactional email.
ADMIN_EMAILS=admin@example.com
PUBLIC_SITE_URL=https://boudoircollectiveberlin.github.io
MAIL_PROVIDER=m365
RESEND_API_KEY=optional-resend-api-key
MAIL_FROM=Boudoir Collective Berlin <bookings@boudoircollectiveberlin.de>
MAIL_REPLY_TO=hello@boudoircollectiveberlin.de
M365_TENANT_ID=your-entra-tenant-id
M365_CLIENT_ID=your-app-client-id
M365_CLIENT_SECRET=your-app-client-secret
M365_AUTH_MODE=application
M365_REFRESH_TOKEN=one-time-generated-refresh-token
M365_REDIRECT_URI=http://localhost
M365_SENDER_EMAIL=bookings@boudoircollectiveberlin.de

# Optional, comma-separated. Leave empty for same-origin only.
ALLOWED_ORIGINS=https://boudoircollectiveberlin.github.io,https://your-vercel-project.vercel.app
