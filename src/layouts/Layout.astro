---
import { readEventCatalog } from '../../shared/read-events.mjs';
import { renderEventPage, serializeEventCatalog } from '../../shared/event-content.mjs';
import { readPublication, composeSitePage } from '../../shared/site-publication.mjs';
interface Props {
  lang: string;
  bodyAttrs?: string;
  head?: string[];
}
const page = Astro.url.pathname.split('/').pop() || 'index.html';
const published=composeSitePage(readPublication(process.cwd()).active.snapshot,page.replace(/\.html$/,''));
if(!published)throw new Error('Seite hat keinen freigegebenen Stand.');
const { lang, bodyAttrs = '', head = [] } = published.meta;
const catalog = await readEventCatalog(process.cwd());
const content = renderEventPage(published.html, catalog, {page,locale:lang});
const renderedHead = renderEventPage(head.join('\n'),catalog,{page,locale:lang});
const bodyProps = Object.fromEntries(
  [...bodyAttrs.matchAll(/([\w-]+)="([^"]*)"/g)].map((m) => [m[1], m[2]]),
);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={renderedHead} />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body {...bodyProps}>
    <Fragment set:html={content} />
    <script is:inline id="bcb-event-catalog" type="application/json" set:html={serializeEventCatalog(catalog)}></script>
    <script is:inline src="i18n.js" defer></script>
    <script is:inline src="site-config.js" defer></script>
    <script is:inline src="script.js" defer></script>
  </body>
</html>
